# PulsePay backend configuration.
# Secrets are delivered by Vault/KMS in production — never hardcoded. The server
# FAILS CLOSED if JWT_SECRET or KMS_DATA_KEY are missing.

# Postgres
DATABASE_URL=postgresql://pulsepay:CHANGE_ME@localhost:5433/pulsepay

# Auth (>=16 chars). From Vault/KMS in prod.
JWT_SECRET=CHANGE_ME_min_16_chars_secret
JWT_EXPIRY=24h
MERCHANT_JWT_EXPIRY=12h

# KMS data key for biometric template envelope encryption: 32 bytes as 64 hex chars or base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KMS_DATA_KEY=

# Biometric matching (calibrate against FAR/FRR targets in production)
BIOMETRIC_MATCH_THRESHOLD=0.86
# A 1:N match must beat the runner-up (another person, or the distress finger) by this much
BIOMETRIC_MATCH_MARGIN=0.03

# Wallet limits (cents). Payments always need the customer's chosen biometric(s) + PIN.
PER_PAYMENT_LIMIT_CENTS=10000
MIN_FUND_CENTS=1000
MAX_BALANCE_CENTS=20000
DISTRESS_CAP_CENTS=2500

# Customer identification session on a merchant device (seconds)
PAY_SESSION_TTL=120

# PIN lockout (card-style)
PIN_MAX_ATTEMPTS=3
PIN_LOCK_MINUTES=30

# DEMO ONLY (the server refuses both when PAYPAL_ENVIRONMENT=live):
#   DEMO_SHOW_OTP  return one-time codes in API responses so a demo works without SMS
#   DEMO_MODE      one-tap "Try the demo": a fresh demo shop + customer per visitor
DEMO_SHOW_OTP=false
DEMO_MODE=false

# Optional external risk advisor (api.typesafe.ai). Leave empty to keep every
# payment check on this server. Only amount, hour and recent amounts are sent.
TYPESAFE_API_KEY=

# PayPal (empty = simulated). Sandbox credentials from developer.paypal.com.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
# manual (default): merchants tap "Cash out"; sales can be refunded until then.
# instant: each sale is paid out right away (no refunds through PulsePay after that).
PAYOUT_MODE=manual
PAYOUT_POLL_SECONDS=20

# AI merchant assistant (Amazon Bedrock API key)
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=zai.glm-5.3
BEDROCK_FALLBACK_MODEL_ID=zai.glm-5

# Optional: Zapier catch hook, Elastic activity index
ZAPIER_WEBHOOK_URL=
ELASTIC_URL=
ELASTIC_API_KEY=

# SMS gateway for one-time codes and alerts (mocked in this demo).
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_PHONE_NUMBER=your_number_here

# CORS allow-list (no wildcard) + rate limit
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=120

PORT=5000
NODE_ENV=development

# Behind one hosting proxy (Render, Heroku), set to 1 so rate limits see the visitor.
TRUST_PROXY=

# One-service deploy (set by the root Dockerfile): serve the built web app from this
# folder, and forward camera frames (/cv/embed-*) to the CV service at this URL.
FRONTEND_DIR=
CV_SERVICE_URL=
