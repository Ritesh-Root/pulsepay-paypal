# Root env for docker compose. Copy to .env and fill in. No defaults for secrets
# (compose fails closed without them — by design).

POSTGRES_USER=pulsepay
POSTGRES_PASSWORD=
POSTGRES_DB=pulsepay

# Backend secrets (from a secrets manager in production)
JWT_SECRET=
# 32 bytes as 64 hex chars (or base64): openssl rand -hex 32
# scripts/setup-env.sh fills POSTGRES_PASSWORD, JWT_SECRET and KMS_DATA_KEY for you.
KMS_DATA_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PayPal (developer.paypal.com -> Apps & Credentials -> Sandbox) ---------------
# Leave empty to run with clearly-labelled simulated PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Only needed when PulsePay has a public URL (e.g. on Render):
PAYPAL_WEBHOOK_ID=
# manual (default): merchants tap "Cash out"; sales can be refunded until then.
# instant: each sale is paid out right away (no refunds through PulsePay after that).
PAYOUT_MODE=manual

# --- AI merchant assistant (Amazon Bedrock API key) -------------------------------
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=zai.glm-5.3
BEDROCK_FALLBACK_MODEL_ID=zai.glm-5

# --- Optional sponsor integrations -------------------------------------------------
# Zapier "Catch Hook" URL: receives sos / payment_receipt / payout_failed / dispute events
ZAPIER_WEBHOOK_URL=
# Elastic Cloud (or local Elasticsearch): activity index + assistant search
ELASTIC_URL=
ELASTIC_API_KEY=
# Optional external risk advisor (api.typesafe.ai)
TYPESAFE_API_KEY=

# DEMO ONLY (refused when PAYPAL_ENVIRONMENT=live):
#   DEMO_SHOW_OTP  show one-time codes in the app so a demo works without SMS
#   DEMO_MODE      one-tap "Try the demo": a fresh demo shop + customer per visitor
DEMO_SHOW_OTP=true
DEMO_MODE=true

# Notifications (mocked SMS in this demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Limits (cents) / timings
BIOMETRIC_MATCH_THRESHOLD=0.86
PER_PAYMENT_LIMIT_CENTS=10000
MAX_BALANCE_CENTS=20000
MIN_FUND_CENTS=1000
DISTRESS_CAP_CENTS=2500
PAY_SESSION_TTL=120
