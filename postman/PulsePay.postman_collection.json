{
  "info": {
    "name": "PulsePay API — PayPal demo flow",
    "description": "Leave your phone at home: pay with a fingerprint or face plus a PIN, funded with PayPal Checkout, merchants cash out with PayPal Payouts.\n\nRun the whole folder top to bottom with the Collection Runner. It needs a backend with DEMO_SHOW_OTP=true (codes are returned in responses) and works in simulated PayPal mode (no keys) or against the PayPal sandbox for everything except approving the top-up, which needs a buyer to click the PayPal button in the app.\n\nBiometric vectors are generated by the pre-request scripts (the camera normally produces them via the CV service).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fresh identities on every run so enrolment never collides with an earlier one.",
          "if (!pm.collectionVariables.get('runId') || pm.info.requestName === '1. PayPal config') {",
          "  const r = Math.floor(Math.random() * 9000000) + 1000000;",
          "  pm.collectionVariables.set('runId', String(r));",
          "  pm.collectionVariables.set('merchantPhone', '1415' + r);",
          "  pm.collectionVariables.set('customerPhone', '1628' + r);",
          "  pm.collectionVariables.set('fingerSeed', String(r * 7 + 11));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. PayPal config",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PayPal config has no secret', () => pm.expect(pm.response.text().toLowerCase()).to.not.include('secret'));",
              "pm.test('mode is reported', () => pm.expect(pm.response.json().mode).to.be.oneOf(['simulated','paypal-sandbox','paypal-live']));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/paypal/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "paypal",
            "config"
          ]
        }
      }
    },
    {
      "name": "Merchant (shop phone)",
      "item": [
        {
          "name": "2. Merchant: request code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('merchantOtp', pm.response.json().demo_otp || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{merchantPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/merchant/request-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "merchant",
                "request-otp"
              ]
            }
          }
        },
        {
          "name": "3. Merchant: register + sign in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('merchant token', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().token).to.be.a('string'); });",
                  "pm.collectionVariables.set('merchantToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{merchantPhone}}\",\n  \"otp\": \"{{merchantOtp}}\",\n  \"display_name\": \"Postman Bakery\",\n  \"paypal_email\": \"bakery-{{runId}}@business.example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/merchant/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "merchant",
                "verify-otp"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Customer (own phone, before leaving home)",
      "item": [
        {
          "name": "4. Customer: request code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('customerOtp', pm.response.json().demo_otp || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{customerPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/enroll/request-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "enroll",
                "request-otp"
              ]
            }
          }
        },
        {
          "name": "5. Customer: verify code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('enrolment token', () => pm.expect(pm.response.json().enrolment_token).to.be.a('string'));",
                  "pm.collectionVariables.set('enrolmentToken', pm.response.json().enrolment_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{customerPhone}}\",\n  \"otp\": \"{{customerOtp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/enroll/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "enroll",
                "verify-otp"
              ]
            }
          }
        },
        {
          "name": "6. PayPal order for a $50 top-up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PayPal order created', () => pm.expect(pm.response.json().order_id).to.be.a('string'));",
                  "pm.collectionVariables.set('paypalOrderId', pm.response.json().order_id);",
                  "if (!pm.response.json().simulated) console.log('Approve order ' + pm.response.json().order_id + ' with the PayPal button in the app before step 7.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{enrolmentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"50\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/enroll/topup-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "enroll",
                "topup-order"
              ]
            }
          }
        },
        {
          "name": "7. Create wallet (fingerprint, captures the PayPal order)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function pulseVec(seed, noiseSeed, noise) {\n  let s = seed >>> 0, n = noiseSeed >>> 0;\n  const out = [];\n  for (let i = 0; i < 1024; i++) {\n    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;\n    n = (Math.imul(n, 22695477) + 1) >>> 0;\n    out.push(+((s / 0xffffffff - 0.5) + noise * (n / 0xffffffff - 0.5)).toFixed(5));\n  }\n  return JSON.stringify(out);\n}",
                  "pm.collectionVariables.set('fingerEnrol', pulseVec(Number(pm.collectionVariables.get('fingerSeed')), 1, 0.02));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('wallet funded with $50.00', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().balance).to.eql(5000); });",
                  "pm.collectionVariables.set('customerToken', pm.response.json().token);",
                  "pm.collectionVariables.set('walletId', pm.response.json().wallet_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{enrolmentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_method\": \"fingerprint\",\n  \"fingerprint_embedding\": {{fingerEnrol}},\n  \"wallet_pin\": \"4827\",\n  \"paypal_order_id\": \"{{paypalOrderId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/enroll/create-wallet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "enroll",
                "create-wallet"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "At the shop (merchant phone, customer phone at home)",
      "item": [
        {
          "name": "8. Identify customer by fingerprint (1:N)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function pulseVec(seed, noiseSeed, noise) {\n  let s = seed >>> 0, n = noiseSeed >>> 0;\n  const out = [];\n  for (let i = 0; i < 1024; i++) {\n    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;\n    n = (Math.imul(n, 22695477) + 1) >>> 0;\n    out.push(+((s / 0xffffffff - 0.5) + noise * (n / 0xffffffff - 0.5)).toFixed(5));\n  }\n  return JSON.stringify(out);\n}",
                  "pm.collectionVariables.set('fingerScan', pulseVec(Number(pm.collectionVariables.get('fingerSeed')), 2, 0.02));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('customer identified, masked', () => { const j = pm.response.json(); pm.expect(j.ready).to.eql(true); pm.expect(j.customer_label).to.match(/••\\d{4}$/); });",
                  "pm.collectionVariables.set('sessionToken', pm.response.json().session_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"fingerprint\",\n  \"embedding\": {{fingerScan}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment/identify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payment",
                "identify"
              ]
            }
          }
        },
        {
          "name": "9. Pay $12.50 with the customer PIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('payment completed', () => pm.expect(pm.response.json().status).to.eql('completed'));",
                  "pm.test('no customer balance on the merchant screen', () => pm.expect(pm.response.json()).to.not.have.property('remaining_balance'));",
                  "pm.collectionVariables.set('transactionId', pm.response.json().transaction_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_token\": \"{{sessionToken}}\",\n  \"amount\": \"12.50\",\n  \"pin\": \"4827\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payment",
                "pay"
              ]
            }
          }
        },
        {
          "name": "10. Same session again (idempotent, no double charge)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('same transaction returned', () => pm.expect(pm.response.json().transaction_id).to.eql(pm.collectionVariables.get('transactionId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_token\": \"{{sessionToken}}\",\n  \"amount\": \"12.50\",\n  \"pin\": \"4827\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payment",
                "pay"
              ]
            }
          }
        },
        {
          "name": "11. Merchant dashboard (sale held, ready to cash out)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('sale on the dashboard', () => pm.expect(j.today.gross_cents).to.eql(1250));",
                  "pm.test('$12.50 held for the merchant, ready to cash out', () => pm.expect(j.balance.available).to.eql(1250));",
                  "pm.test('no distress data exposed', () => pm.expect(pm.response.text().toLowerCase()).to.not.include('distress'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/merchant/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "merchant",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "12. Cash out to PayPal (Payouts)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('payout for the whole $12.50', () => { pm.response.to.have.status(200); pm.expect(j.payout.amount).to.eql(1250); });",
                  "pm.test('payout not failed', () => pm.expect(String(j.payout.status).toLowerCase()).to.not.include('fail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/merchant/cashout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "merchant",
                "cashout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "13. Refund after cash-out is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('money already paid out cannot be refunded from PulsePay', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error).to.include('already been paid out');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{merchantToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/merchant/refunds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "merchant",
                "refunds"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"{{transactionId}}\",\n  \"reason\": \"customer changed mind\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Back home (customer phone)",
      "item": [
        {
          "name": "14. Wallet balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('balance is $37.50', () => pm.expect(pm.response.json().wallet.balance).to.eql(3750));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/{{walletId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallet",
                "{{walletId}}"
              ]
            }
          }
        },
        {
          "name": "15. Close wallet: refund to PayPal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('$37.50 refunded to the PayPal capture', () => pm.expect(pm.response.json().refunded_amount).to.eql(3750));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": \"{{walletId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/refund",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallet",
                "refund"
              ]
            }
          }
        }
      ]
    }
  ]
}
